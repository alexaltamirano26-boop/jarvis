# ============================================================
#  JARVIS – Konfiguration
#  Diese Datei ist nur eine VORLAGE. Die echte Datei heißt ".env"
#  und wird von "python scripts/setup.py" erstellt.
#  Die .env NIEMALS hochladen oder teilen!
# ============================================================

# --- KI (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
# Modell: claude-haiku-5-5 (günstig) | claude-sonnet-5-5 | claude-opus-5-5 (am stärksten)
JARVIS_MODEL=claude-haiku-5-5
# Denktiefe: low | medium | high  (höher = gründlicher, aber teurer)
JARVIS_EFFORT=low
# Wie viele frühere Nachrichten JARVIS mitliest
JARVIS_HISTORY_LIMIT=30

# --- Persönliches ---
JARVIS_USER_NAME=Alex
JARVIS_TIMEZONE=Europe/Berlin

# --- Sicherheit (werden von scripts/setup.py automatisch gesetzt) ---
JARVIS_PASSWORD_HASH=
JARVIS_SECRET_KEY=
# Erst beim Online-Betrieb mit HTTPS auf true setzen
JARVIS_SECURE_COOKIES=false
